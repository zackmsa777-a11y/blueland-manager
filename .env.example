# Token for the BlueLand Manager bot application. Use a bot token, without a Bot prefix.
DISCORD_BOT_TOKEN=
# Comma-separated Discord role IDs allowed to use promotion commands in addition to Manage Roles.
PROMOTER_ROLE_IDS=
# Dashboard listens on loopback. For hosting, put an HTTPS reverse proxy in front of it.
PORT=4196
# Set this to the canonical HTTPS origin when using a reverse proxy.
PUBLIC_ORIGIN=
