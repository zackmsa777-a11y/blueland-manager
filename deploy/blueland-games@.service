[Unit]
Description=Prepare or publish a reviewed BlueLand games revision

[Service]
User=blueland-publish
SupplementaryGroups=blueland-check
StateDirectory=blueland-publish
StateDirectoryMode=0755
WorkingDirectory=/var/lib/blueland-publish
ExecStart=/usr/bin/python3 -I /usr/local/libexec/blueland-game-publisher.py
LoadCredential=github_key:/etc/blueland-publish/github_key
Environment=GIT_TERMINAL_PROMPT=0 GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=220
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
PrivateDevices=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
InaccessiblePaths=-/etc/blueland -/etc/blueland-hermes -/etc/blueland-publish/github_key -/var/lib/blueland-hermes -/var/lib/blueland -/var/lib/blueland-workspace
UMask=0022
