[Unit]
Description=Verify and publish a BlueLand feature request

[Service]
User=blueland-publish
Group=blueland-publish
SupplementaryGroups=blueland-check
StateDirectory=blueland-publish
StateDirectoryMode=0755
WorkingDirectory=/var/lib/blueland-publish
ExecStart=/usr/bin/python3 -I /usr/local/libexec/blueland-publish.py
LoadCredential=bot.env:/etc/blueland/bot.env
LoadCredential=github_key:/etc/blueland-publish/github_key
Environment=GIT_TERMINAL_PROMPT=0
Environment=GIT_CONFIG_NOSYSTEM=1
Environment=GIT_CONFIG_GLOBAL=/dev/null
EnvironmentFile=/etc/blueland-publish/operators
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=240
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectControlGroups=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
InaccessiblePaths=-/var/lib/blueland -/var/lib/blueland-workspace -/etc/blueland -/etc/blueland-publish/github_key -/run/dbus -/run/systemd/private -/run/blueland-workspace.sock -/run/blueland-codex.sock
UMask=0022
