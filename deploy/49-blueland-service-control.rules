polkit.addRule(function(action, subject) {
    if (subject.user !== "blueland" || action.id !== "org.freedesktop.systemd1.manage-units") return;
    var unit = action.lookup("unit");
    if (action.lookup("verb") === "restart" &&
        (unit === "blueland.service" || unit === "blueland-cloudflared.service")) {
        return polkit.Result.YES;
    }
});
