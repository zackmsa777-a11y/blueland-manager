[Unit]
Description=BlueLand Codex request

[Service]
User=ubuntu
Group=blueland
Environment=HOME=/home/ubuntu
Environment=CODEX_HOME=/home/ubuntu/.codex
WorkingDirectory=/tmp
ExecStart=/usr/bin/python3 /opt/blueland-manager/deploy/codex-worker.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=180
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/ubuntu/.codex
InaccessiblePaths=/etc/blueland /var/lib/blueland -/etc/blueland-cloudflare -/run/blueland-codex.sock -/run/dbus -/run/snapd.socket -/var/snap/lxd -/run/systemd/private
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
TasksMax=128
MemoryMax=1G
