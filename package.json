{
  "name": "blueland-manager",
  "version": "1.1.0",
  "private": true,
  "description": "BlueLand Empire promotion bot and Arabic staff dashboard",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "roles:check": "node --env-file-if-exists=.env scripts/rebind-roles.js",
    "roles:sync": "node --env-file-if-exists=.env scripts/rebind-roles.js --apply"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "quickjs-emscripten": "0.32.0"
  }
}
